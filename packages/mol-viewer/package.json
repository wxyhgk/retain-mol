{
  "name": "@retainmol/mol-viewer",
  "version": "0.1.28",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/public/core.d.ts",
      "import": "./dist/public/core.js"
    },
    "./io": {
      "types": "./dist/public/io.d.ts",
      "import": "./dist/public/io.js"
    },
    "./viewer": {
      "types": "./dist/public/viewer.d.ts",
      "import": "./dist/public/viewer.js"
    },
    "./styles": {
      "types": "./dist/public/styles.d.ts",
      "import": "./dist/public/styles.js"
    },
    "./fragments": {
      "types": "./dist/public/fragments.d.ts",
      "import": "./dist/public/fragments.js"
    },
    "./coordination": {
      "types": "./dist/public/coordination.d.ts",
      "import": "./dist/public/coordination.js"
    },
    "./samples": {
      "types": "./dist/public/samples.d.ts",
      "import": "./dist/public/samples.js"
    },
    "./templates": {
      "types": "./dist/public/templates.d.ts",
      "import": "./dist/public/templates.js"
    },
    "./pubchem": {
      "types": "./dist/public/pubchem.d.ts",
      "import": "./dist/public/pubchem.js"
    },
    "./optimize": {
      "types": "./dist/optimize.d.ts",
      "import": "./dist/optimize.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/prune-declarations.mjs && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "openchemlib": "^9.21.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
