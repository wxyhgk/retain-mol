{
  "$schemaVersion": "1",
  "kind": "theme",
  "metadata": {
    "id": "iboview",
    "name": "IboView 风",
    "description": "IboView source-style theme: white background, Rasmol CPKnew colors with medium-gray carbon, and shiny-chic ball-stick bond proportions.",
    "source": "https://www.iboview.org/_bldUPAt.html",
    "author": "RetainMol",
    "version": "0.1.0"
  },
  "extends": "default",
  "scene": {
    "backgroundColor": "#ffffff",
    "highlightColor": "#3399ff",
    "highlightOpacity": 0.3
  },
  "render": {
    "ballScale": 0.4,
    "bondRadiusStick": 0.077,
    "bondGap": 0.22,
    "spacefillScale": 0.8
  },
  "fallbackColor": "#ff1493",
