{
  "$schemaVersion": "1",
  "kind": "theme",
  "metadata": {
    "id": "paton",
    "name": "论文·Paton",
    "description": "移植自 xyzrender 的 paton 出版预设：白底 + 灰白碳的简洁标准风，柔和杂原子色，印刷最耐看。原预设的黑描边（atom_stroke）需渲染层实现，主题层暂不覆盖。",
    "source": "https://github.com/aligfellow/xyzrender",
    "author": "RetainMol (adapted from xyzrender, MIT)",
    "version": "1.0.0"
  },
  "extends": "default",
  "scene": {
    "backgroundColor": "#ffffff",
    "highlightColor": "#2563eb",
    "highlightOpacity": 0.3
  },
  "render": {
    "ballScale": 0.4,
    "bondRadiusStick": 0.085,
    "bondGap": 0.18
  },
  "elements": {
    "C": { "color": "#d9d9d9" },
    "H": { "color": "#fafafa" },
    "N": { "color": "#7f7fbf" }
  }
}
