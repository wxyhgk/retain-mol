{
  "$schemaVersion": "1",
  "kind": "theme",
  "metadata": {
    "id": "default",
    "name": "默认 (Jmol CPK)",
    "description": "基于 Jmol 的经典 CPK 配色。",
    "source": "http://jmol.sourceforge.net/jscolors/",
    "author": "RetainMol",
    "version": "1.0.0"
  },
