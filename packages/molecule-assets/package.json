{
  "name": "@retainmol/molecule-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@retainmol/core": ">=0.2.0",
    "@retainmol/viewer": ">=0.2.0",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.184.0 <0.185.0"
  },
  "dependencies": {
    "@retainmol/ui-kit": "file:../ui-kit",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^1.8.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@retainmol/core": "file:../core",
    "@retainmol/viewer": "file:../viewer",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
