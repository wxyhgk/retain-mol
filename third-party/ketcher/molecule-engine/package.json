{
  "name": "molecule-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-independent molecule graph editing sessions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-commonjs-package.mjs",
    "test:types": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "molecule-contracts": "file:../molecule-contracts"
  }
}
