node_modules/
dist/
# Vendored Ketcher sources ship their prebuilt dist (rebuilding needs the
# rollup/WASM toolchain); everything else under dist/ stays ignored.
!third-party/ketcher/*/dist/
# npm 会把 file: 依赖自身的依赖装进包目录（与根 node_modules 同理的可再生安装产物，不提交）
third-party/ketcher/*/node_modules/
.cache/
*.local
.DS_Store
**/.ipynb_checkpoints/
*.tsbuildinfo
packages/mol-viewer/node_modules
packages/mol-viewer/temp/
.retainmol-loop/
**/.lake/

# Local credentials and private keys
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Python
__pycache__/
*.pyc
*.pyo

# xTB 运行时临时文件
software/backend/.xtboptok
software/backend/charges
software/backend/wbo
software/backend/gfnff_topo
software/backend/xtbrestart
software/backend/xtbtopo.mol
software/backend/xtbopt.log
software/backend/xtbopt.xyz
software/backend/xtb.out

# Psi4 runtime scratch generated when imported outside the isolated worker
timer.dat

# Persistent local job workspace (SQLite records and calculation artifacts)
software/backend/data/
packages/mol-viewer/node_modules
