mindmap
  root((packages/mol-viewer/src))
    public["public/ 对外子路径 API"]
      core["core.ts: molecule 类型 / 原子键工具 / 元素配置"]
      viewer["viewer.ts: MolViewer / stores / builder hook"]
      styles["styles.ts: theme / style preset / render profile 注册"]
      io["io.ts: MOL/SDF/XYZ/GJF 解析导出"]
      fragments["fragments.ts: 片段查询"]
      samples["samples.ts: 示例分子"]
      pubchem["pubchem.ts: PubChem 查询"]
    components["components/ 包内 React 组件"]
      viewerComponents["viewer/"]
        MolViewer["MolViewer.tsx: viewer 外壳"]
        overlays["AtomLabelOverlay / MeasureOverlay / BoxSelectOverlay"]
        controls["AtomContextMenu / RotateGizmo"]
      builderComponents["builder/"]
        BuilderHint["BuilderHint.tsx"]
    hooks["hooks/ React 与 renderer/store 接线"]
      useBuilder["useBuilder.ts: 建模交互入口，仍需拆分"]
      pointerRouter["useCanvasPointerRouter.ts: pointer routing / drag / box select"]
      rendererBinding["useRendererBinding.ts: renderer 生命周期和回调绑定"]
      viewerSync["useMolViewerSync.ts: props 与 store 同步"]
    store["store/ Zustand 状态层"]
      moleculeStore["moleculeStore.ts: molecule scene state + undo 组装"]
      editorStore["editorStore.ts: 工具 / 显示 / theme / 测量 UI 状态"]
      integrity["integrity.ts: store integrity helper"]
      slices["slices/"]
        sceneSlice["sceneSlice.ts: scene objects / active object / visible / locked"]
        editSlice["editSlice.ts: edit action 组装层"]
        atomEditActions["atomEditActions.ts: atom / H / charge actions"]
        bondEditActions["bondEditActions.ts: bond actions"]
        moleculeEditActions["moleculeEditActions.ts: molecule / position actions"]
        geometryEditActions["geometryEditActions.ts: geometry actions"]
        clipboardEditActions["clipboardEditActions.ts: copy / paste actions"]
        selectionEditActions["selectionEditActions.ts: selected edit actions"]
        transactionController["transactionController.ts: undo transaction controller"]
        selectionSlice["selectionSlice.ts: 选择状态"]
        helpers["helpers.ts: selector / immutable update helper"]
        undoConfig["undoConfig.ts: undo snapshot policy"]
        types["types.ts: store contracts"]
    lib["lib/ 核心算法与渲染内部"]
      moleculeCore["molecule.ts / types.ts / sceneObject.ts"]
        molecule["molecule.ts: parse/export XYZ / newAtom / newBond / center"]
        sceneObject["sceneObject.ts: 多对象 scene object"]
        types["types.ts: DisplayMode / Tool / Measurement 等类型"]
      builder["builder/ 建模逻辑"]
        editing["editing/"]
          atomOps["atomOps.ts: 替换原子 / grow H / 补 H"]
          bondOps["bondOps.ts: 成键 / 键长循环"]
          fragmentOps["fragment/: 片段放置 / 接枝 / 并环"]
          geometryOps["geometryOps.ts: 键长 / 键角 / 二面角编辑"]
        geometry["geometry/"]
          vsepr["vsepr.ts: VSEPR 放置"]
          plane["plane.ts: 草图平面"]
          measure["measure.ts: distance / angle / dihedral"]
        analysis["analysis/"]
          aromaticity["aromaticity.ts: 芳香性"]
          conjugation["conjugation.ts: 共轭"]
          hybridization["hybridization.ts: 杂化"]
          fragmentsAnalysis["fragments.ts: 连通片段"]
        commands["commands/"]
          atomCommands["atom/: 点击 / 替换 / 生长 / 补 H"]
          bondCommands["bond/: 点击 / 拖拽 / 成键 / 键级"]
          fragmentCommands["fragment/: 接枝 / 并环 / 放置"]
          sceneCommands["scene/: 分子 / 对象 / 坐标变换"]
          supportCommands["selection / geometry / clipboard / interaction / shared"]
        graph["graph.ts: 邻接图 / bond query"]
        queries["queries.ts: H slot / grow query"]
        valence["valence.ts: 价态计算"]
        fragmentLibrary["fragmentLibrary.ts: 内置片段库"]
      molRenderer["molRenderer/ Three.js renderer"]
        MolRenderer["MolRenderer.ts: scene/camera/controls/render loop，多对象编排，仍偏大"]
        MoleculeRenderer["MoleculeRenderer.ts: 单 molecule atom/bond mesh 生命周期，仍偏大"]
        stylePrimitives["moleculeStylePrimitives.ts: 材质 / 颜色 / 半径 / opacity"]
        selectionVisuals["moleculeSelectionVisuals.ts: halo / outline / drag hover"]
        interaction["InteractionHandler.ts: picking / pointer gestures"]
        measureVisuals["MeasureVisuals.ts: 测量视觉"]
        ghostVisuals["GhostVisuals.ts: 拖拽成键引导"]
        sceneRig["sceneRig.ts: lights / fog / grid"]
        postprocessing["postprocessing.ts: DOF"]
        publicationMaterials["publicationMaterials.ts: publication / IboView 材质"]
        geometryHelpers["bondGeometry / measureGeometry / ghostGeometry / gizmoMath"]
      ioLib["io/"]
        molFormat["molFormat.ts: MOL/SDF + 3D/minimize"]
        pasteParser["pasteParser.ts: clipboard / GJF / raw coords"]
      geometryLib["geometry/relax.ts: 几何松弛"]
      controls["controls/MolControls.ts: 轨道控制"]
      animation["animation/Ticker.ts: 统一渲染 ticker"]
      samples["samples.ts: 示例数据"]
      pubchemLib["pubchem.ts: PubChem client"]
    config["config/ 共享配置"]
      cameraConfig["camera.config.ts"]
      renderConfig["render.config.ts"]
      elementsConfig["elements.config.ts"]
      geometryConfig["geometry.config.ts"]
      bondingConfig["bonding.config.ts"]
      interactionConfig["interaction.config.ts"]
      overlayConfig["overlay.config.ts"]
      toolCapabilities["toolCapabilities.config.ts"]
      rotateGizmoConfig["rotateGizmo.config.ts"]
      relaxConfig["relax.config.ts"]
    presets["presets/ theme 体系"]
      schema["schema.ts: Theme schema"]
      loader["loader.ts: registerTheme / resolveTheme / listThemes"]
      themes["themes/*.json: default / dark / gaussview / iboview / pymol / paper"]
    styles["styles/ style preset 与 render profile"]
      styleSchema["schema.ts: StylePreset schema"]
      styleLoader["loader.ts: registerStylePreset / resolveStylePreset"]
      renderProfiles["renderProfiles.ts: registerRenderProfile / resolveRenderProfile"]
      stylePresets["presets/*.json: retainmol / gaussview / iboview / pymol / publication"]
      profileImpl["profiles/iboview-renderer-profile.ts"]
    rootFiles["根文件"]
      index["index.ts: 兼容根导出，后续继续弱化"]
      optimize["optimize.ts: 优化子入口"]
      capture["capture.ts: viewport capture bridge"]
