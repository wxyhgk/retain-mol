{
  "name": "mol-viewer-consumer-example",
  "private": true,
  "type": "module",
  "scripts": {
    "resources": "node scripts/copy-resources.mjs",
    "dev": "npm run resources && vite --host 127.0.0.1 --port 5273 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/consumer.test.mjs",
