  },
  "dependencies": {
    "@retainmol/mol-viewer": "0.1.29",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "0.184.0",
    "openchemlib": "9.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "tailwindcss": "4.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.0",
    "typescript": "~6.0.2",
    "vite": "8.0.10"
  }
}
