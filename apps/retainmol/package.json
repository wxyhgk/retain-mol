{
  "name": "retainmol",
  "private": true,
  "version": "0.0.39",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocl-resources.mjs && npm run build --workspace @retainmol/mol-viewer",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-ocl-resources.mjs && npm run build --workspace @retainmol/mol-viewer",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts",
    "postbuild": "node scripts/check-sites-build.mjs",
    "check:sites-build": "node scripts/check-sites-build.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "report:coupling": "node scripts/report-coupling.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "npm run build --workspace @retainmol/mol-viewer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@retainmol/mol-viewer": "file:../../packages/mol-viewer",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/three": "^0.184.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.8.0",
    "openchemlib": "^9.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^17.0.0",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^2.1.9",
    "react-virtuoso": "^4.18.10",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
